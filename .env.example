# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will not be committed

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Phone app builds only: where the API lives. Leave empty for the website (it uses its own address).
# For an emulator talking to a server on this computer: http://10.0.2.2:8080
API_BASE_URL=
